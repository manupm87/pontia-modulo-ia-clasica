# --- Dialogflow ---
# local = emulador incluido (sin cuenta de Google) | google = API real de Dialogflow ES
DIALOGFLOW_BACKEND=local
DIALOGFLOW_PROJECT_ID=tu-proyecto-dialogflow
# Clave JSON de la cuenta de servicio (rol "Dialogflow API Client"). NUNCA al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\clave.json
# URL del webhook que usa el emulador local
WEBHOOK_URL=http://127.0.0.1:8000/webhook

# --- LLM para la consulta documental ---
LLM_BACKEND=ollama            # ollama | gemini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434   # 127.0.0.1 y no localhost: en Windows localhost prueba IPv6 primero (+2 s)
GOOGLE_API_KEY=               # solo si LLM_BACKEND=gemini

# --- Voz ---
WHISPER_MODEL=small
TTS_BACKEND=edge              # edge | elevenlabs | xtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # voz clonada: python -m voz.clonar_voz elevenlabs

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_RESPUESTA_VOZ=voz    # voz | siempre | nunca

# --- Ajustes avanzados de voz ---
EDGE_VOZ=es-ES-ElviraNeural
ELEVENLABS_MODEL=eleven_multilingual_v2
XTTS_URL=http://127.0.0.1:8020    # servidor de voz clonada: .venv-xtts\Scripts\python -m voz.xtts_servidor
WHISPER_DEVICE=auto               # auto | cuda | cpu
TTS_CACHE=1
TTS_CACHE_DIR=.cache/tts
